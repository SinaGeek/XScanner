<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="4dp">

    <CheckBox android:id="@+id/checkBox" android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvIp" android:layout_width="0dp" android:layout_weight="1"
        android:text="IP" />
    <TextView android:id="@+id/tvPing" android:layout_width="60dp" android:text="Ping" />
    <TextView android:id="@+id/tvJitter" android:layout_width="60dp" android:text="Jitter" />
    <TextView android:id="@+id/tvLatency" android:layout_width="60dp" android:text="Latency" />
    <TextView android:id="@+id/tvUpload" android:layout_width="70dp" android:text="Up" />
    <TextView android:id="@+id/tvDownload" android:layout_width="70dp" android:text="Down" />
</LinearLayout>